
# GRAVITY SWITCH RUNNER
# Inspired by G-Switch 3
# Developed using Python and Pygame
# No user-defined functions

import pygame
import random
import sys

pygame.init()

# SCREEN SETTINGS

WIDTH = 1000
HEIGHT = 500

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("GRAVITY SWITCH RUNNER")

clock = pygame.time.Clock()

# COLORS

BLACK = (12, 14, 30)
WHITE = (255, 255, 255)
BLUE = (30, 160, 255)
CYAN = (0, 255, 230)
RED = (255, 65, 90)
PURPLE = (130, 70, 255)
GREY = (55, 65, 90)

# GAME SETTINGS

PLAYER_X = 180
PLAYER_W = 35
PLAYER_H = 38

FLOOR_Y = 410
CEILING_Y = 65

speed = 6
distance = 0
score = 0

lane = "floor"
game_over = False

# FONTS

font = pygame.font.SysFont("Arial", 25, bold=True)
big_font = pygame.font.SysFont("Arial", 55, bold=True)
small_font = pygame.font.SysFont("Arial", 18)

# BACKGROUND STARS

stars = []

for i in range(90):

    stars.append([
        random.randint(0, WIDTH),
        random.randint(0, HEIGHT),
        random.randint(1, 3)
    ])

# OBSTACLES

obstacles = []

next_spawn = 500

# PLAYER

player = pygame.Rect(
    PLAYER_X,
    FLOOR_Y - PLAYER_H,
    PLAYER_W,
    PLAYER_H
)

# MAIN GAME LOOP

while True:

    clock.tick(60)

    # EVENTS

    for event in pygame.event.get():

        if event.type == pygame.QUIT:

            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:

                pygame.quit()
                sys.exit()

            if event.key in [
                pygame.K_SPACE,
                pygame.K_UP
            ] and game_over == False:

                if lane == "floor":

                    lane = "ceiling"

                else:

                    lane = "floor"

            if event.key == pygame.K_r and game_over:

                obstacles = []

                distance = 0
                score = 0
                speed = 6

                next_spawn = 500

                lane = "floor"
                game_over = False

    # UPDATE GAME

    if game_over == False:

        distance += speed

        score = distance // 10

        # INCREASE DIFFICULTY

        if score > 0 and score % 100 == 0:

            speed = min(12, 6 + score // 100)

        # UPDATE PLAYER POSITION

        if lane == "floor":

            player.y = FLOOR_Y - PLAYER_H

        else:

            player.y = CEILING_Y

        # GENERATE NEW OBSTACLES

        while next_spawn < distance + WIDTH:

            obstacle_lane = random.choice([
                "floor",
                "ceiling"
            ])

            obstacle_type = random.choice([
                "block",
                "block",
                "gap"
            ])

            if obstacle_type == "block":

                obstacle_length = 55

            else:

                obstacle_length = 115

            obstacles.append([
                next_spawn,
                obstacle_lane,
                obstacle_type,
                obstacle_length
            ])

            next_spawn += random.randint(300, 420)

        # COLLISION DETECTION

        for obstacle in obstacles:

            world_x = obstacle[0]
            obstacle_lane = obstacle[1]
            obstacle_type = obstacle[2]
            obstacle_length = obstacle[3]

            screen_x = world_x - distance + PLAYER_X

            obstacle_rect = pygame.Rect(
                screen_x,
                0,
                obstacle_length,
                HEIGHT
            )

            # CHECK ONLY THE CURRENT LANE

            if lane == obstacle_lane:

                if obstacle_type == "block":

                    if lane == "floor":

                        hazard = pygame.Rect(
                            screen_x,
                            FLOOR_Y - 65,
                            obstacle_length,
                            65
                        )

                    else:

                        hazard = pygame.Rect(
                            screen_x,
                            CEILING_Y + PLAYER_H - 10,
                            obstacle_length,
                            65
                        )

                    if player.colliderect(hazard):

                        game_over = True

                # GAP DETECTION

                elif obstacle_type == "gap":

                    if player.colliderect(obstacle_rect):

                        game_over = True

        # REMOVE OLD OBSTACLES

        for obstacle in obstacles[:]:

            if obstacle[0] + obstacle[3] < distance - 250:

                obstacles.remove(obstacle)

    # DRAW BACKGROUND

    screen.fill(BLACK)

    # DRAW STARS

    for star in stars:

        pygame.draw.circle(
            screen,
            GREY,
            (star[0], star[1]),
            star[2]
        )

        if game_over == False:

            star[0] -= speed // 2

            if star[0] < 0:

                star[0] = WIDTH

                star[1] = random.randint(0, HEIGHT)

    # DRAW CEILING AND FLOOR

    pygame.draw.rect(
        screen,
        BLUE,
        (0, 55, WIDTH, 10)
    )

    pygame.draw.rect(
        screen,
        BLUE,
        (0, FLOOR_Y, WIDTH, 10)
    )

    # DRAW OBSTACLES AND GAPS

    for obstacle in obstacles:

        world_x = obstacle[0]
        obstacle_lane = obstacle[1]
        obstacle_type = obstacle[2]
        obstacle_length = obstacle[3]

        screen_x = world_x - distance + PLAYER_X

        if -150 < screen_x < WIDTH + 150:

            if obstacle_type == "block":

                if obstacle_lane == "floor":

                    pygame.draw.rect(
                        screen,
                        RED,
                        (screen_x, FLOOR_Y - 65,
                         obstacle_length, 65)
                    )

                else:

                    pygame.draw.rect(
                        screen,
                        PURPLE,
                        (screen_x,
                         CEILING_Y + PLAYER_H - 10,
                         obstacle_length, 65)
                    )

            else:

                # VISUAL GAP IN THE TRACK

                if obstacle_lane == "floor":

                    pygame.draw.rect(
                        screen,
                        BLACK,
                        (screen_x, FLOOR_Y,
                         obstacle_length, 10)
                    )

                else:

                    pygame.draw.rect(
                        screen,
                        BLACK,
                        (screen_x, 55,
                         obstacle_length, 10)
                    )

    # DRAW PLAYER

    pygame.draw.rect(
        screen,
        CYAN,
        player,
        border_radius=8
    )

    # PLAYER GLOW EFFECT

    pygame.draw.rect(
        screen,
        WHITE,
        player,
        2,
        border_radius=8
    )

    # SCORE DISPLAY

    score_text = font.render(
        "SCORE: " + str(score),
        True,
        WHITE
    )

    screen.blit(score_text, (25, 20))

    speed_text = small_font.render(
        "SPEED: " + str(speed),
        True,
        CYAN
    )

    screen.blit(speed_text, (25, 52))

    # GRAVITY STATUS

    gravity_text = font.render(
        "GRAVITY: " + lane.upper(),
        True,
        CYAN if lane == "floor" else PURPLE
    )

    screen.blit(
        gravity_text,
        (WIDTH - 260, 20)
    )

    # CONTROL INFORMATION

    control_text = small_font.render(
        "SPACE / UP = SWITCH GRAVITY",
        True,
        WHITE
    )

    screen.blit(
        control_text,
        (WIDTH // 2 - 145, HEIGHT - 35)
    )

    # GAME OVER SCREEN

    if game_over:

        overlay = pygame.Surface(
            (WIDTH, HEIGHT)
        )

        overlay.set_alpha(190)
        overlay.fill(BLACK)

        screen.blit(overlay, (0, 0))

        title = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        final_score = font.render(
            "FINAL SCORE: " + str(score),
            True,
            WHITE
        )

        restart = font.render(
            "PRESS R TO RESTART",
            True,
            CYAN
        )

        screen.blit(
            title,
            (WIDTH // 2 - title.get_width() // 2, 170)
        )

        screen.blit(
            final_score,
            (WIDTH // 2 - final_score.get_width() // 2, 250)
        )

        screen.blit(
            restart,
            (WIDTH // 2 - restart.get_width() // 2, 310)
        )

    pygame.display.update()
