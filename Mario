
import pygame
import random
import sys

pygame.init()

# -------------------- SETTINGS --------------------

WIDTH = 900
HEIGHT = 600
FPS = 60

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Pixel Adventure")

clock = pygame.time.Clock()

# Colors
SKY = (110, 190, 255)
GRASS = (60, 190, 80)
DIRT = (140, 85, 45)
BROWN = (100, 55, 30)
YELLOW = (255, 220, 50)
RED = (230, 60, 60)
WHITE = (255, 255, 255)
BLACK = (20, 20, 30)
BLUE = (40, 100, 240)

font = pygame.font.SysFont("consolas", 25)
big_font = pygame.font.SysFont("consolas", 48, bold=True)

# World
WORLD_WIDTH = 4000
GROUND_Y = 520

# -------------------- PLAYER --------------------

player = pygame.Rect(100, 400, 36, 48)

player_velocity_y = 0
player_speed = 5
jump_power = -15
gravity = 0.7

on_ground = False

# -------------------- PLATFORMS --------------------

platforms = [
    pygame.Rect(300, 430, 160, 25),
    pygame.Rect(550, 350, 150, 25),
    pygame.Rect(850, 420, 180, 25),
    pygame.Rect(1150, 350, 160, 25),
    pygame.Rect(1450, 420, 180, 25),
    pygame.Rect(1750, 330, 180, 25),
    pygame.Rect(2100, 420, 200, 25),
    pygame.Rect(2450, 350, 180, 25),
    pygame.Rect(2800, 420, 200, 25),
    pygame.Rect(3200, 350, 180, 25),
]

# -------------------- COINS --------------------

coins = []

for platform in platforms:
    for i in range(3):
        coins.append(
            pygame.Rect(
                platform.x + 30 + i * 40,
                platform.y - 35,
                20,
                20
            )
        )

# -------------------- ENEMIES --------------------

enemies = []

for x in range(500, WORLD_WIDTH - 300, 350):
    enemies.append({
        "rect": pygame.Rect(x, GROUND_Y - 35, 35, 35),
        "direction": random.choice([-1, 1]),
        "speed": 2
    })

# -------------------- GAME STATE --------------------

camera_x = 0
score = 0
lives = 3

game_over = False
won = False


def draw_player(rect):
    # Head
    pygame.draw.rect(
        screen,
        (255, 190, 130),
        (rect.x, rect.y, rect.width, 20)
    )

    # Hat
    pygame.draw.rect(
        screen,
        RED,
        (rect.x - 3, rect.y - 5, rect.width + 6, 10)
    )

    # Body
    pygame.draw.rect(
        screen,
        BLUE,
        (rect.x, rect.y + 20, rect.width, 18)
    )

    # Legs
    pygame.draw.rect(
        screen,
        BROWN,
        (rect.x + 3, rect.y + 38, 12, 10)
    )

    pygame.draw.rect(
        screen,
        BROWN,
        (rect.x + 21, rect.y + 38, 12, 10)
    )

    # Eye
    pygame.draw.rect(
        screen,
        BLACK,
        (rect.x + 25, rect.y + 8, 5, 5)
    )


def draw_coin(rect):
    pygame.draw.circle(
        screen,
        YELLOW,
        rect.center,
        11
    )

    pygame.draw.circle(
        screen,
        (255, 170, 0),
        rect.center,
        11,
        3
    )


def draw_enemy(rect):
    pygame.draw.rect(
        screen,
        RED,
        rect,
        border_radius=8
    )

    # Eyes
    pygame.draw.circle(
        screen,
        WHITE,
        (rect.x + 10, rect.y + 12),
        5
    )

    pygame.draw.circle(
        screen,
        WHITE,
        (rect.x + 25, rect.y + 12),
        5
    )

    pygame.draw.circle(
        screen,
        BLACK,
        (rect.x + 10, rect.y + 12),
        2
    )

    pygame.draw.circle(
        screen,
        BLACK,
        (rect.x + 25, rect.y + 12),
        2
    )


def draw_world():
    screen.fill(SKY)

    # Clouds
    for x in range(0, WORLD_WIDTH, 500):
        cloud_x = x - camera_x

        pygame.draw.circle(
            screen,
            WHITE,
            (cloud_x + 40, 100),
            30
        )

        pygame.draw.circle(
            screen,
            WHITE,
            (cloud_x + 70, 100),
            40
        )

        pygame.draw.circle(
            screen,
            WHITE,
            (cloud_x + 100, 100),
            30
        )

    # Ground
    pygame.draw.rect(
        screen,
        GRASS,
        (0, GROUND_Y - 10, WIDTH, 20)
    )

    pygame.draw.rect(
        screen,
        DIRT,
        (0, GROUND_Y + 10, WIDTH, HEIGHT)
    )

    # Ground decoration
    for x in range(0, WORLD_WIDTH, 60):
        pygame.draw.rect(
            screen,
            BROWN,
            (x - camera_x, GROUND_Y + 30, 30, 10)
        )

    # Platforms
    for platform in platforms:
        visible_platform = platform.move(-camera_x, 0)

        pygame.draw.rect(
            screen,
            GRASS,
            visible_platform
        )

        pygame.draw.rect(
            screen,
            DIRT,
            (
                visible_platform.x,
                visible_platform.y + 10,
                visible_platform.width,
                visible_platform.height
            )
        )


def reset_game():
    global player, player_velocity_y
    global score, lives, camera_x
    global game_over, won

    player.x = 100
    player.y = 400

    player_velocity_y = 0

    score = 0
    lives = 3
    camera_x = 0

    game_over = False
    won = False


# -------------------- MAIN LOOP --------------------

while True:
    clock.tick(FPS)

    # Events
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:
                pygame.quit()
                sys.exit()

            if event.key == pygame.K_SPACE:
                if game_over or won:
                    reset_game()

                elif on_ground:
                    player_velocity_y = jump_power
                    on_ground = False

            if event.key == pygame.K_r:
                reset_game()

    keys = pygame.key.get_pressed()

    if not game_over and not won:

        # Horizontal movement
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            player.x -= player_speed

        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            player.x += player_speed

        # Gravity
        player_velocity_y += gravity
        player.y += player_velocity_y

        on_ground = False

        # Ground collision
        if player.bottom >= GROUND_Y:
            player.bottom = GROUND_Y
            player_velocity_y = 0
            on_ground = True

        # Platform collision
        for platform in platforms:

            if player.colliderect(platform):

                if player_velocity_y > 0:
                    player.bottom = platform.top
                    player_velocity_y = 0
                    on_ground = True

        # Collect coins
        for coin in coins[:]:

            if player.colliderect(coin):
                coins.remove(coin)
                score += 10

        # Enemy movement and collisions
        for enemy in enemies[:]:

            enemy["rect"].x += (
                enemy["direction"] * enemy["speed"]
            )

            if enemy["rect"].x < 0 or enemy["rect"].x > WORLD_WIDTH:
                enemy["direction"] *= -1

            if player.colliderect(enemy["rect"]):

                # Jump on enemy
                if player_velocity_y > 0 and player.bottom < enemy["rect"].centery:
                    enemies.remove(enemy)
                    player_velocity_y = -10
                    score += 50

                else:
                    lives -= 1
                    player.x = max(0, player.x - 100)
                    player.y = 400
                    player_velocity_y = 0

                    if lives <= 0:
                        game_over = True

        # Camera scrolling
        camera_x = player.x - WIDTH // 2

        camera_x = max(
            0,
            min(camera_x, WORLD_WIDTH - WIDTH)
        )

        # Win condition
        if player.x >= WORLD_WIDTH - 100:
            won = True

        # Falling out of world
        if player.y > HEIGHT:
            lives -= 1
            player.x = 100
            player.y = 400
            player_velocity_y = 0

            if lives <= 0:
                game_over = True

    # -------------------- DRAWING --------------------

    draw_world()

    # Coins
    for coin in coins:
        draw_coin(coin.move(-camera_x, 0))

    # Enemies
    for enemy in enemies:
        draw_enemy(enemy["rect"].move(-camera_x, 0))

    # Player
    draw_player(player.move(-camera_x, 0))

    # Finish flag
    flag_x = WORLD_WIDTH - 100 - camera_x

    pygame.draw.line(
        screen,
        BLACK,
        (flag_x, 350),
        (flag_x, GROUND_Y),
        6
    )

    pygame.draw.polygon(
        screen,
        RED,
        [
            (flag_x, 350),
            (flag_x + 60, 370),
            (flag_x, 390)
        ]
    )

    # HUD
    score_text = font.render(
        f"COINS: {score}",
        True,
        BLACK
    )

    lives_text = font.render(
        f"LIVES: {lives}",
        True,
        BLACK
    )

    screen.blit(score_text, (20, 20))
    screen.blit(lives_text, (WIDTH - 150, 20))

    # Game over
    if game_over:

        text = big_font.render(
            "GAME OVER",
            True,
            RED
        )

        screen.blit(
            text,
            text.get_rect(
                center=(WIDTH // 2, HEIGHT // 2)
            )
        )

        draw_text = font.render(
            "Press SPACE to restart",
            True,
            WHITE
        )

        screen.blit(
            draw_text,
            draw_text.get_rect(
                center=(WIDTH // 2, HEIGHT // 2 + 60)
            )
        )

    # Win screen
    if won:

        text = big_font.render(
            "LEVEL COMPLETE!",
            True,
            YELLOW
        )

        screen.blit(
            text,
            text.get_rect(
                center=(WIDTH // 2, HEIGHT // 2)
            )
        )

        draw_text = font.render(
            f"FINAL SCORE: {score}",
            True,
            WHITE
        )

        screen.blit(
            draw_text,
            draw_text.get_rect(
                center=(WIDTH // 2, HEIGHT // 2 + 60)
            )
        )

    pygame.display.update()
